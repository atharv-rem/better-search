{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Better Search",
  "version": "0.6.0",
  "identifier": "better-search",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Better Search",
        "label": "better-search",
        "create": false,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "width": 488,
        "height": 120,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENzc5QjYwNDM1OEY2MTcKUldRWDlsaERZSnQzTFFoZEwxUytESlFDUG0xdlZnSnAxNmNXK1AvNFpXSitOZXpPR1Fhc0d0a0YK",
      "endpoints": [
        "https://github.com/atharv-rem/better-search/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Atharv Remeshan",
    "copyright": "Copyright © 2026 Atharv Remeshan",
    "category": "Utility",
    "shortDescription": "Fast file search for Windows",
    "longDescription": "Press a shortcut anywhere, type part of a file name and open it. Better Search indexes your NTFS drives' file names so results appear while you type.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    },
    "externalBin": [
      "binaries/better-search-helper",
      "binaries/better-search-watcher",
      "binaries/better-search-indexer"
    ]
  }
}
